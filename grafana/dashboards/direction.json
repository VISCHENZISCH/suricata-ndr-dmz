{
  "uid": "suri-direction",
  "title": "Suricata - Vue Direction",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["suricata", "ifri"],
  "panels": [
    {
      "id": 1,
      "title": "Alertes sur la période",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"suricata\",event_type=\"alert\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Alertes critiques sév.1 (SLO cible = 0)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"suricata\",event_type=\"alert\",severity=\"1\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Sonde active (SLO disponibilité)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"suricata\",event_type=\"stats\"}[2m]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": { "from": 1, "to": 1000000, "result": { "text": "OK" } }
            },
            {
              "type": "special",
              "options": { "match": "null+nan", "result": { "text": "HORS LIGNE" } }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Santé : événements analysés",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"suricata\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Alertes par sévérité",
      "type": "piechart",
      "datasource": { "type": "loki", "uid": "loki" },
      "maxDataPoints": 2,
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (severity) (count_over_time({job=\"suricata\",event_type=\"alert\"}[$__range]))",
          "refId": "A",
          "legendFormat": "sév. {{severity}}",
          "queryType": "range"
        }
      ],
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"],
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sév. 1" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sév. 2" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sév. 3" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Top 10 attaquants (IP source)",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "maxDataPoints": 2,
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "topk(10, sum by (src_ip) (count_over_time({job=\"suricata\",event_type=\"alert\"} | json src_ip=\"src_ip\" | src_ip != \"\" [$__range])))",
          "refId": "A",
          "legendFormat": "{{src_ip}}",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "includeTimeField": false,
            "mode": "seriesToRows",
            "reducers": ["lastNotNull"]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "LastNotNull" }]
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "number" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Évolution des alertes",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (severity) (count_over_time({job=\"suricata\",event_type=\"alert\"}[1m]))",
          "refId": "A",
          "legendFormat": "sév. {{severity}}",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
